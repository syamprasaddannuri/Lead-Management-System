# Copy to deploy/.env on the VM and fill in. Never commit the real .env.
# DB: shared Cloud SQL instance via the Cloud SQL Auth Proxy.
CLOUD_SQL_CONNECTION=emerald-entity-496003-g7:asia-southeast1:lead-management-db
DB_NAME=leadmanagement
DB_USER=lead-management-service
DB_PASSWORD=__from Secret Manager: db-password__
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
SUPERADMIN_EMAIL=team@example.com
SUPERADMIN_PASSWORD=Team@12345
# stage = temp password always 123456, no credential emails
# prod  = random temp password emailed on invite + forgot-password
APP_PASSWORD_MODE=prod
# Outbound email over SMTP. Lead capture works without it.
# Using Twilio SendGrid's SMTP relay: username is the literal word "apikey",
# password is the SendGrid API key (SG.xxxx). Sender domain example.com must be
# domain-authenticated in SendGrid. (Was Amazon SES previously.)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=__SendGrid API key (SG.xxxx)__
MAIL_FROM=team@example.com
MAIL_FROM_NAME=Lead Management System

# Inbound lead replies via SendGrid Inbound Parse (optional; lead email works without it).
# 1. Add an MX record: reply.example.com -> mx.sendgrid.net (priority 10).
# 2. SendGrid > Settings > Inbound Parse: host reply.example.com,
#    URL https://sales.example.com/api/inbound/sendgrid?key=<INBOUND_WEBHOOK_SECRET>
# Replies to reply.example.com then land on the matching lead's timeline.
INBOUND_REPLY_DOMAIN=reply.example.com
INBOUND_HMAC_SECRET=__long random string; signs the per-lead reply address__
INBOUND_WEBHOOK_SECRET=__long random string; shared secret in the Parse webhook URL__
